<?xml version="1.0" encoding="UTF-8"?>

<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <!-- Elemento principal -->
    <xs:element name="articulos">

        <xs:complexType>
            <xs:sequence>

                <!-- Lista de artículos -->
                <xs:element name="articulo"
                            minOccurs="1"
                            maxOccurs="unbounded">

                    <xs:complexType>
                        <xs:sequence>

                            <xs:element name="tipo" type="xs:string"/>

                            <xs:element name="fecha_adquisicion" type="xs:string"/>

                            <xs:element name="procedencia" type="xs:string"/>

                            <xs:element name="numero_articulo" type="xs:string"/>

                            <xs:element name="duracion_cortejo_procesional"
                                        type="xs:string"
                                        minOccurs="0"/>

                            <xs:element name="destacado" minOccurs="0">
                                <xs:complexType/>
                            </xs:element>

                        </xs:sequence>

                        <!-- Identificador obligatorio -->
                        <xs:attribute name="id"
                                      type="xs:positiveInteger"
                                      use="required"/>

                    </xs:complexType>

                </xs:element>

            </xs:sequence>

            <!-- Propietario obligatorio -->
            <xs:attribute name="propietario"
                          type="xs:string"
                          use="required"/>

        </xs:complexType>

    </xs:element>

</xs:schema>
