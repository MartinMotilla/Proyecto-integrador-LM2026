<!ELEMENT tipo (#PCDATA)>
<!ELEMENT fecha_adquisicion (#PCDATA)>
<!ELEMENT procedencia (#PCDATA)>
<!ELEMENT numero_articulo (#PCDATA)>
<!ELEMENT duracion_cortejo_procesional (#PCDATA)>
<!ELEMENT destacado EMPTY>